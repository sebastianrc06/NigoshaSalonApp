<?xml version='1.0' encoding='utf-8'?>
<resources>
    <style name="Widget.Nigosha.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/nigosha_primary</item>
        <item name="android:textColor">@color/nigosha_on_brand</item>
    </style>
    <style name="Widget.Nigosha.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
    </style>
    <style name="Widget.Nigosha.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/nigosha_surface</item>
        <item name="strokeColor">@color/nigosha_border</item>
        <item name="strokeWidth">1dp</item>
    </style>
    <style name="TextAppearance.Nigosha.Heading" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/nigosha_text_title</item>
    </style>
    <style name="TextAppearance.Nigosha.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/nigosha_text_title</item>
    </style>
    <style name="TextAppearance.Nigosha.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/nigosha_text_body</item>
    </style>
    <style name="TextAppearance.Nigosha.Caption" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/nigosha_text_muted</item>
    </style>
</resources>