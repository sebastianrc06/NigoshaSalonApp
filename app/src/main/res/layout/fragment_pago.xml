<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/pagoRoot" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/nigosha_bg">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnVolverPago" style="?attr/materialButtonOutlinedStyle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Volver" android:textAllCaps="false" android:textColor="@color/nigosha_text_title" app:cornerRadius="12dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="EL SIGUIENTE PASO DE TU RESERVA" android:textColor="@color/nigosha_gold" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Tu adelanto" android:textColor="@color/nigosha_text_title" android:textSize="28sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Consulta los importes y el estado de pago de tu cita." android:textColor="@color/nigosha_text_body" android:textSize="15sp" />
            <ProgressBar android:id="@+id/progressPago" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center_horizontal" android:layout_marginTop="24dp" android:indeterminateTint="@color/nigosha_primary" />
            <TextView android:id="@+id/tvMensajePago" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:textColor="@color/nigosha_text_body" android:textSize="15sp" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnReintentarPago" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="12dp" android:text="Reintentar" android:textAllCaps="false" android:visibility="gone" />
            <LinearLayout android:id="@+id/contenidoPago" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" app:cardBackgroundColor="@color/nigosha_primary" app:cardCornerRadius="20dp" app:cardElevation="0dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TU SERVICIO" android:textColor="@color/nigosha_brand_caption" android:textSize="11sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvPagoServicio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/white" android:textSize="21sp" android:textStyle="bold" />
                        <TextView android:id="@+id/tvPagoFecha" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/nigosha_brand_caption" android:textSize="14sp" />
                        <TextView android:id="@+id/tvPagoCodigo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/nigosha_brand_caption" android:textSize="12sp" android:textIsSelectable="true" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/nigosha_surface" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/nigosha_border" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                        <TextView android:id="@+id/tvPagoEstado" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/nigosha_text_muted" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Adelanto requerido" android:textColor="@color/nigosha_text_body" android:textSize="15sp" />
                        <TextView android:id="@+id/tvPagoRequerido" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/nigosha_gold" android:textSize="32sp" android:textStyle="bold" />
                        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginVertical="20dp" android:background="@color/nigosha_border" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Precio total del servicio" android:textColor="@color/nigosha_text_muted" android:textSize="13sp" />
                        <TextView android:id="@+id/tvPagoTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/nigosha_text_title" android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Adelanto abonado" android:textColor="@color/nigosha_text_muted" android:textSize="13sp" />
                        <TextView android:id="@+id/tvPagoAbonado" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/nigosha_text_title" android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Saldo pendiente actual" android:textColor="@color/nigosha_text_muted" android:textSize="13sp" />
                        <TextView android:id="@+id/tvPagoSaldo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/nigosha_text_title" android:textSize="20sp" android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <TextView android:id="@+id/tvPagoAviso" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@color/nigosha_surface_soft" android:padding="16dp" android:textColor="@color/nigosha_text_body" android:textSize="14sp" />
                <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:minHeight="56dp" android:enabled="false" android:text="Pago en línea próximamente" android:textAllCaps="false" app:cornerRadius="14dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:layout_marginBottom="20dp" android:gravity="center" android:text="Todavía no se realizará ningún cobro." android:textColor="@color/nigosha_text_muted" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>