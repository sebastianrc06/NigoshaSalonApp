<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/nigosha_bg">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/nigosha_primary" android:paddingHorizontal="20dp" android:paddingTop="8dp" android:paddingBottom="24dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnVolverReserva" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="48dp" android:paddingHorizontal="0dp" android:text="‹  Volver al servicio" android:textAllCaps="false" android:textColor="@color/nigosha_on_brand" android:textSize="14sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="TU VISITA A NIGOSHA" android:textColor="@color/nigosha_gold_decorative" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Reserva un momento para ti" android:textColor="@color/nigosha_on_brand" android:textSize="28sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Elige cuándo visitarnos. Nosotros cuidamos los detalles." android:textColor="@color/nigosha_brand_caption" android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <ProgressBar android:id="@+id/progressReserva" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center_horizontal" android:layout_marginVertical="16dp" android:indeterminateTint="@color/nigosha_accent" />
                <TextView android:id="@+id/tvErrorReserva" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingVertical="16dp" android:visibility="gone" android:textAppearance="@style/TextAppearance.Nigosha.Body" />
                <com.google.android.material.button.MaterialButton android:id="@+id/btnReintentarReserva" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:text="Reintentar" android:visibility="gone" />
                <LinearLayout android:id="@+id/contenidoReserva" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <com.google.android.material.card.MaterialCardView style="@style/Widget.Nigosha.Card" android:layout_width="match_parent" android:layout_height="wrap_content">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/nigosha_surface_soft" android:paddingHorizontal="20dp" android:paddingVertical="12dp" android:text="SERVICIO SELECCIONADO" android:textColor="@color/nigosha_text_title" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.08" />
                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                                <TextView android:id="@+id/tvReservaServicio" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/nigosha_text_title" android:textSize="21sp" android:textStyle="bold" />
                                <TextView android:id="@+id/tvReservaImportes" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/nigosha_text_body" android:textSize="15sp" android:lineSpacingExtra="5dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView style="@style/Widget.Nigosha.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="01  ·  Elige el día" android:textAppearance="@style/TextAppearance.Nigosha.Title" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Selecciona la fecha de tu visita." android:textAppearance="@style/TextAppearance.Nigosha.Caption" />
                            <com.google.android.material.button.MaterialButton android:id="@+id/btnElegirFechaReserva" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="14dp" android:text="Elegir día" android:textAllCaps="false" android:textColor="@color/nigosha_text_title" android:textSize="17sp" app:cornerRadius="14dp" app:strokeColor="@color/nigosha_border" app:icon="@android:drawable/ic_menu_my_calendar" app:iconTint="@color/nigosha_text_title" app:iconGravity="textStart" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView style="@style/Widget.Nigosha.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="02  ·  Elige la hora" android:textAppearance="@style/TextAppearance.Nigosha.Title" />
                            <TextView android:id="@+id/tvMensajeHorarios" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Selecciona primero un día." android:textColor="@color/nigosha_text_body" android:textSize="14sp" />
                            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvHorariosReserva" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:nestedScrollingEnabled="false" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.card.MaterialCardView style="@style/Widget.Nigosha.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="03  ·  Tus datos" android:textAppearance="@style/TextAppearance.Nigosha.Title" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Usaremos estos datos para coordinar tu cita." android:textAppearance="@style/TextAppearance.Nigosha.Caption" />
                            <com.google.android.material.textfield.TextInputLayout android:id="@+id/inputNombreReserva" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="Nombre y apellido">
                                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etNombreReserva" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" android:maxLines="1" android:imeOptions="actionNext" />
                            </com.google.android.material.textfield.TextInputLayout>
                            <com.google.android.material.textfield.TextInputLayout android:id="@+id/inputTelefonoReserva" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Celular de contacto" app:helperText="Número peruano de 9 dígitos">
                                <com.google.android.material.textfield.TextInputEditText android:id="@+id/etTelefonoReserva" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" android:maxLength="15" android:maxLines="1" android:imeOptions="actionDone" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:paddingHorizontal="4dp" android:text="Tu solicitud quedará pendiente de confirmación y pago. Todavía no se realizará ningún cobro desde la aplicación." android:textColor="@color/nigosha_text_muted" android:textSize="13sp" android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/nigosha_surface">
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/nigosha_border" android:importantForAccessibility="no" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnRevisarReserva" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginHorizontal="20dp" android:layout_marginVertical="12dp" android:enabled="false" android:text="Revisar y solicitar cita" android:textAllCaps="false" android:textSize="15sp" app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>