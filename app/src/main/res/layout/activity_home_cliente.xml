<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nigosha_bg"
    android:orientation="vertical">

    <!-- Encabezado de Marca Nigosha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/nigosha_primary"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:text="NIGOSHA"
            android:textColor="@color/nigosha_gold"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Salón &amp; Spa"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Atención botánica personalizada"
            android:textColor="@color/nigosha_accent"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Selector de Pestañas: Catálogo / Mis Citas -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:checkedButton="@id/btnVerServicios"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerServicios"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Catálogo"
            android:textAllCaps="false"
            android:textColor="@color/nigosha_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVerMisCitas"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Mis Citas"
            android:textAllCaps="false"
            android:textColor="@color/nigosha_primary" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Lista de Contenido -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPrincipal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp" />

</LinearLayout>