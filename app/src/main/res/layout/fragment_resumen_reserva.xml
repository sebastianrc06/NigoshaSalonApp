<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/nigosha_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnEditarResumen" style="?attr/materialButtonOutlinedStyle" android:textColor="@color/nigosha_text_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="56dp" android:text="‹  Editar selección" android:textAllCaps="false" app:cornerRadius="14dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="REVISA TU VISITA" android:textColor="@color/nigosha_gold" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Todo listo para solicitar" android:textColor="@color/nigosha_text_title" android:textSize="28sp" android:textStyle="bold" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/nigosha_border" app:cardBackgroundColor="@color/nigosha_primary">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="" android:textColor="@color/white" android:textSize="23sp" android:id="@+id/tvResumenServicio" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="" android:textColor="@color/nigosha_brand_caption" android:textSize="15sp" android:id="@+id/tvResumenFecha" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="" android:textColor="@color/nigosha_brand_caption" android:textSize="13sp" android:id="@+id/tvResumenFin" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/nigosha_border" app:cardBackgroundColor="@color/nigosha_surface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Datos de contacto" android:textColor="@color/nigosha_text_title" android:textSize="19sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Cliente" android:textColor="@color/nigosha_text_muted" android:textSize="12sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" android:textColor="@color/nigosha_text_title" android:textSize="16sp" android:id="@+id/tvResumenCliente" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Celular" android:textColor="@color/nigosha_text_muted" android:textSize="12sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" android:textColor="@color/nigosha_text_title" android:textSize="16sp" android:id="@+id/tvResumenTelefono" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/nigosha_border" app:cardBackgroundColor="@color/nigosha_surface">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Importes de tu visita" android:textColor="@color/nigosha_text_title" android:textSize="19sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Precio total" android:textColor="@color/nigosha_text_muted" android:textSize="12sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" android:textColor="@color/nigosha_text_title" android:textSize="16sp" android:id="@+id/tvResumenTotal" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Adelanto requerido (50%)" android:textColor="@color/nigosha_text_muted" android:textSize="12sp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="" android:textColor="@color/nigosha_gold" android:textSize="24sp" android:id="@+id/tvResumenAdelanto" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Adelanto abonado: S/ 0.00" android:textColor="@color/nigosha_text_body" android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="" android:textColor="@color/nigosha_text_body" android:textSize="14sp" android:id="@+id/tvMensajeResumen" android:accessibilityLiveRegion="polite" />
        <ProgressBar android:id="@+id/progressResumen" android:layout_width="36dp" android:layout_height="36dp" android:layout_gravity="center_horizontal" android:visibility="gone" android:layout_marginTop="16dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnReintentarResumen" style="?attr/materialButtonOutlinedStyle" android:textColor="@color/nigosha_text_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="56dp" android:text="Reintentar verificación" android:textAllCaps="false" app:cornerRadius="14dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnConfirmarResumen" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="56dp" android:text="Solicitar cita" android:textAllCaps="false" app:cornerRadius="14dp" />
    </LinearLayout>
</ScrollView>