<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/nigosha_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/nigosha_primary" android:orientation="vertical" android:padding="24dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:letterSpacing="0.10" android:text="CONOCE NUESTRO ESPACIO" android:textColor="@color/nigosha_brand_caption" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Nigosha" android:textColor="@color/white" android:textSize="32sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Salón &amp; Spa" android:textColor="@color/nigosha_brand_caption" android:textSize="18sp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Tu próxima visita empieza aquí." android:textColor="@color/white" android:textSize="15sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Te esperamos en Comas" android:textColor="@color/nigosha_text_title" android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Encuentra nuestra ubicación y organiza tu llegada al salón." android:textColor="@color/nigosha_text_body" android:textSize="15sp" />
            <TextView android:id="@+id/tvAvisoSalon" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/nigosha_text_muted" android:textSize="13sp" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnReintentarSalon" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Actualizar información" android:visibility="gone" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" app:cardBackgroundColor="@color/nigosha_surface" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/nigosha_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:letterSpacing="0.06" android:text="NUESTRA UBICACIÓN" android:textColor="@color/nigosha_gold" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:id="@+id/tvSalonDireccion" android:text="Av. San Felipe 272" android:textColor="@color/nigosha_text_title" android:textIsSelectable="true" android:textSize="21sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:id="@+id/tvSalonDistrito" android:text="Comas 15313 · Lima, Perú" android:textColor="@color/nigosha_text_muted" android:textSize="14sp" />
                    <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="18dp" app:cardBackgroundColor="@color/nigosha_surface_soft" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/nigosha_border" app:strokeWidth="1dp">
                        <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                            <FrameLayout android:id="@+id/contenedorMapaSalon" android:layout_width="match_parent" android:layout_height="match_parent" />
                            <TextView android:id="@+id/tvEstadoMapaSalon" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/nigosha_surface_soft" android:gravity="center" android:padding="16dp" android:text="Cargando mapa…" android:textColor="@color/nigosha_text_muted" android:textSize="14sp" />
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnComoLlegarSalon" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:backgroundTint="@color/nigosha_primary" android:minHeight="56dp" android:text="Cómo llegar" android:textAllCaps="false" android:textColor="@color/white" app:cornerRadius="14dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnVerMapaSalon" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:minHeight="56dp" android:text="Ver ubicación en Google Maps" android:textAllCaps="false" android:textColor="@color/nigosha_text_title" app:cornerRadius="14dp" app:strokeColor="@color/nigosha_border" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/nigosha_surface" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeColor="@color/nigosha_border" app:strokeWidth="1dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Hablemos de tu visita" android:textColor="@color/nigosha_text_title" android:textSize="19sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="¿Tienes alguna consulta? Escríbenos y te ayudaremos con nuestros servicios o tu próxima visita." android:textColor="@color/nigosha_text_body" android:textSize="14sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Contacto" android:textColor="@color/nigosha_text_muted" android:textSize="12sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:id="@+id/tvSalonTelefono" android:text="+51 990 938 752" android:textColor="@color/nigosha_text_title" android:textIsSelectable="true" android:textSize="22sp" android:textStyle="bold" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnWhatsAppSalon" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:backgroundTint="#176B45" android:minHeight="56dp" android:text="Escríbenos por WhatsApp" android:textAllCaps="false" android:textColor="@color/white" app:cornerRadius="14dp" app:icon="@drawable/ic_whatsapp" app:iconGravity="textStart" app:iconPadding="10dp" app:iconSize="24dp" app:iconTint="@color/white" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnLlamarSalon" style="?attr/materialButtonOutlinedStyle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:minHeight="56dp" android:text="Llamar al contacto" android:textAllCaps="false" android:textColor="@color/nigosha_text_title" app:cornerRadius="14dp" app:strokeColor="@color/nigosha_border" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" app:cardBackgroundColor="@color/nigosha_surface_soft" app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Horarios de atención" android:textColor="@color/nigosha_text_title" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:id="@+id/tvSalonHorario" android:text="Por confirmar" android:textColor="@color/nigosha_text_body" android:textSize="15sp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Consulta con el salón antes de acudir sin una cita confirmada." android:textColor="@color/nigosha_text_muted" android:textSize="13sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>