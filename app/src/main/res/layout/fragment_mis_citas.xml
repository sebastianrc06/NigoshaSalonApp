<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/nigosha_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@color/nigosha_primary" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="TUS VISITAS A NIGOSHA" android:textColor="@color/nigosha_gold_decorative" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.1" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Mis citas" android:textColor="@color/nigosha_on_brand" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Consulta tus solicitudes y organiza tu próxima visita." android:textColor="@color/nigosha_brand_caption" android:textSize="14sp" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/toggleMisCitas" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginVertical="16dp" app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@id/btnCitasProximas">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCitasProximas" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_weight="1" android:text="Próximas" android:textAllCaps="false" android:textColor="@color/nigosha_text_title" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCitasHistorial" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_weight="1" android:text="Historial" android:textAllCaps="false" android:textColor="@color/nigosha_text_title" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <ProgressBar android:id="@+id/progressMisCitas" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="center_horizontal" android:indeterminateTint="@color/nigosha_accent" />
    <TextView android:id="@+id/tvOperacionMisCitas" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingVertical="12dp" android:visibility="gone" android:textAppearance="@style/TextAppearance.Nigosha.Body" />
    <TextView android:id="@+id/tvMensajeMisCitas" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="20dp" android:gravity="center" android:visibility="gone" android:textAppearance="@style/TextAppearance.Nigosha.Body" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btnReintentarMisCitas" android:layout_width="wrap_content" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_gravity="center_horizontal" android:text="Reintentar" android:visibility="gone" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvMisCitas" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="20dp" />
</LinearLayout>