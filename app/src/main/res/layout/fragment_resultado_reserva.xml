<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/nigosha_bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="SOLICITUD REGISTRADA" android:textColor="@color/nigosha_gold" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Gracias por elegir Nigosha" android:textColor="@color/nigosha_text_title" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Consulta el estado de tu visita. Registrar la solicitud no confirma un pago." android:textColor="@color/nigosha_text_body" android:textSize="14sp" />
        <include layout="@layout/view_loading" />
        <include layout="@layout/view_error" />
        <LinearLayout android:id="@+id/contenidoResultado" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <include layout="@layout/view_detalle_cita" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnAdelantoResultado" style="?attr/materialButtonOutlinedStyle" android:textColor="@color/nigosha_text_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="56dp" android:text="Ver adelanto" android:textAllCaps="false" app:cornerRadius="14dp" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnCitasResultado" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="56dp" android:text="Ver mis citas" android:textAllCaps="false" app:cornerRadius="14dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnServiciosResultado" style="?attr/materialButtonOutlinedStyle" android:textColor="@color/nigosha_text_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:minHeight="56dp" android:text="Volver a servicios" android:textAllCaps="false" app:cornerRadius="14dp" />
    </LinearLayout>
</ScrollView>