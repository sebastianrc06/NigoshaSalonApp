<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/nigosha_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical">


        <!-- CABECERA -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:background="@color/nigosha_primary"

            android:orientation="vertical"

            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <com.google.android.material.button.MaterialButton

                android:id="@+id/btnVolverLogin"

                style="@style/Widget.MaterialComponents.Button.TextButton"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:minHeight="40dp"

                android:text="‹  Volver"
                android:textAllCaps="false"
                android:textColor="@color/nigosha_on_brand"

                app:backgroundTint="@android:color/transparent" />

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="14dp"

                android:text="CREA TU CUENTA"

                android:textColor="@color/nigosha_brand_caption"
                android:textSize="12sp"
                android:textStyle="bold"

                android:letterSpacing="0.14" />

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="7dp"

                android:text="Bienvenido a Nigosha"

                android:textColor="@color/nigosha_on_brand"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="7dp"

                android:text="Verifica tu DNI y completa tus datos para crear tu cuenta."

                android:textColor="@color/nigosha_brand_caption"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- CONTENIDO -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical"

            android:paddingStart="20dp"
            android:paddingTop="26dp"
            android:paddingEnd="20dp"
            android:paddingBottom="36dp">


            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="01 · Verifica tu identidad"

                android:textColor="@color/nigosha_text_title"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="5dp"
                android:layout_marginBottom="18dp"

                android:text="Ingresa tu DNI. Tus nombres y apellidos se completarán automáticamente."

                android:textColor="@color/nigosha_text_muted"
                android:textSize="13sp" />


            <com.google.android.material.textfield.TextInputLayout

                android:id="@+id/inputDniRegistro"

                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:hint="DNI"

                app:boxStrokeColor="@color/nigosha_primary">

                <com.google.android.material.textfield.TextInputEditText

                    android:id="@+id/etDniRegistro"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:minHeight="56dp"

                    android:digits="0123456789"
                    android:inputType="number"
                    android:maxLength="8"

                    android:imeOptions="actionDone"

                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.button.MaterialButton

                android:id="@+id/btnVerificarDni"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:minHeight="50dp"

                android:text="Verificar DNI"
                android:textAllCaps="false"
                android:textStyle="bold"

                android:textColor="@color/nigosha_on_brand"

                app:backgroundTint="@color/nigosha_primary"
                app:cornerRadius="12dp" />


            <ProgressBar

                android:id="@+id/progressDni"

                android:layout_width="28dp"
                android:layout_height="28dp"

                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"

                android:visibility="gone" />


            <TextView

                android:id="@+id/tvEstadoDni"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:gravity="center"

                android:textColor="@color/nigosha_primary"
                android:textSize="13sp"
                android:textStyle="bold"

                android:visibility="gone" />


            <com.google.android.material.textfield.TextInputLayout

                android:id="@+id/inputNombresRegistro"

                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:hint="Nombres">

                <com.google.android.material.textfield.TextInputEditText

                    android:id="@+id/etNombresRegistro"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:minHeight="56dp"

                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout

                android:id="@+id/inputApellidoPaternoRegistro"

                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:hint="Apellido paterno">

                <com.google.android.material.textfield.TextInputEditText

                    android:id="@+id/etApellidoPaternoRegistro"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:minHeight="56dp"

                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout

                android:id="@+id/inputApellidoMaternoRegistro"

                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:hint="Apellido materno">

                <com.google.android.material.textfield.TextInputEditText

                    android:id="@+id/etApellidoMaternoRegistro"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:minHeight="56dp"

                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>


            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="32dp"

                android:text="02 · Datos de contacto"

                android:textColor="@color/nigosha_text_title"
                android:textSize="18sp"
                android:textStyle="bold" />


            <com.google.android.material.textfield.TextInputLayout

                android:id="@+id/inputTelefonoRegistro"

                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:hint="Celular">

                <com.google.android.material.textfield.TextInputEditText

                    android:id="@+id/etTelefonoRegistro"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:minHeight="56dp"

                    android:digits="0123456789"
                    android:inputType="phone"
                    android:maxLength="9"

                    android:imeOptions="actionNext"
                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout

                android:id="@+id/inputCorreoRegistro"

                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:hint="Correo electrónico">

                <com.google.android.material.textfield.TextInputEditText

                    android:id="@+id/etCorreoRegistro"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:minHeight="56dp"

                    android:inputType="textEmailAddress"
                    android:imeOptions="actionNext"

                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>


            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="32dp"

                android:text="03 · Seguridad"

                android:textColor="@color/nigosha_text_title"
                android:textSize="18sp"
                android:textStyle="bold" />


            <com.google.android.material.textfield.TextInputLayout

                android:id="@+id/inputPasswordRegistro"

                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="18dp"

                android:hint="Contraseña"

                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText

                    android:id="@+id/etPasswordRegistro"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:minHeight="56dp"

                    android:inputType="textPassword"
                    android:imeOptions="actionNext"

                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.textfield.TextInputLayout

                android:id="@+id/inputConfirmarPasswordRegistro"

                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="12dp"

                android:hint="Confirmar contraseña"

                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText

                    android:id="@+id/etConfirmarPasswordRegistro"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:minHeight="56dp"

                    android:inputType="textPassword"
                    android:imeOptions="actionDone"

                    android:singleLine="true" />

            </com.google.android.material.textfield.TextInputLayout>


            <com.google.android.material.button.MaterialButton

                android:id="@+id/btnCrearCuenta"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="28dp"

                android:minHeight="56dp"

                android:text="Crear cuenta"
                android:textAllCaps="false"
                android:textColor="@color/nigosha_on_brand"
                android:textSize="16sp"
                android:textStyle="bold"

                app:backgroundTint="@color/nigosha_primary"
                app:cornerRadius="14dp" />


            <TextView

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:layout_marginTop="16dp"

                android:gravity="center"

                android:text="Al registrarte, tu cuenta será creada como Cliente."

                android:textColor="@color/nigosha_text_muted"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>