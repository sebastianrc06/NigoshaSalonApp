<?xml version='1.0' encoding='utf-8'?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" style="@style/Widget.Nigosha.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="20dp" android:layout_marginBottom="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:id="@+id/tvMiCitaEstado" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/nigosha_text_muted" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvMiCitaServicio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textAppearance="@style/TextAppearance.Nigosha.Title" />
        <TextView android:id="@+id/tvMiCitaFecha" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textAppearance="@style/TextAppearance.Nigosha.Body" />
        <TextView android:id="@+id/tvMiCitaPago" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textAppearance="@style/TextAppearance.Nigosha.Caption" />
        <TextView android:id="@+id/tvMiCitaTotal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/nigosha_gold" android:textSize="18sp" android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnMiCitaDetalle" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="56dp" android:layout_marginTop="14dp" android:text="Ver detalle" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>